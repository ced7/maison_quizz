## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Lo]g/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/lib/

# Visual Studio 2017 AutoGenerated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# NUNIT
CompileLog.txt

# Visual Studio Profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Files
*.utp

# ReSharper is a Font-End development tool
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a Font-End development tool
.JustCode

# TeamCity is a build automation tool
_TeamCity*

# DotCover is a Code Coverage Tool
*.dotCover

# AxoCover is a Code Coverage Tool
.axoCover/*
!.axoCover/settings.json

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# MyGet
web.config

# Node.js / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Visual Studio BitMap Cache
ChromeProxy/

# ES2015 with Babel
.babelrc

# grunt-cli
.grunt

# bower
bower_components/

# node-sass
.sass-cache

# Dependency directories
bin/
obj/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCop.Cache

# Files built by Visual Studio
*.pdb
*.swp
*.lutp
*.lcov

# Rider
.idea/
*.sln.iml

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
