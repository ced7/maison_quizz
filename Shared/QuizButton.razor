@* Composant de bouton stylisé réutilisable *@

<button @onclick="OnClick" disabled="@Disabled" class="quiz-button">
    @Text
</button>

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;
    
    [Parameter]
    public EventCallback OnClick { get; set; }
    
    [Parameter]
    public bool Disabled { get; set; }
}
